
export COMPOSE_PROJECT_NAME=rspy-demo

######################################
# Include other docker-compose files #
######################################

COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=./docker-compose.yml

####################################################
# Environment variables read by docker-compose.yml #
####################################################

# This file and docker-compose.yml are used only in local mode
export RSPY_LOCAL_MODE=1

# rs-server urls
export RSPY_HOST_ADGS=http://rs-server-adgs:8000
export RSPY_HOST_PRIP=http://rs-server-prip:8000
export RSPY_HOST_CADIP=http://rs-server-cadip:8000
export RSPY_HOST_EDRS=http://rs-server-edrs:8000
export RSPY_HOST_PRIP=http://rs-server-prip:8000
export RSPY_HOST_CATALOG=http://rs-server-catalog:8000
export RSPY_HOST_STAGING=http://rs-server-staging:8000
export RSPY_HOST_DPR_SERVICE=http://rs-dpr-service:8000
export RSPY_UAC_HOMEPAGE=http://localhost:9999/docs
# NOTE: must be in the same order as in rs-server/services/frontend/.github/entrypoint_frontend.sh
# with the catalog at the end.
export STAC_BROWSER_URLS="http://localhost:8101;http://localhost:8102;http://localhost:8105;http://localhost:8106;http://localhost:8103"

# postgresql database
export POSTGRES_USER=postgres
export POSTGRES_PASSWORD=postgres
export POSTGRES_HOST=postgres # host = the docker container name
export POSTGRES_PORT=5432
export POSTGRES_DB=rspy-demo
export POSTGRES_PI_DB=rspy-pi-demo

# pg stac database (used by the catalog)
export PGSTAC_USER=postgres
export PGSTAC_PASSWORD=password
export PGSTAC_HOST=catalog-db # container name
export PGSTAC_PORT=5439
export PGSTAC_DB=catalog

# s3 bucket
export S3_ACCESSKEY=minio
export S3_SECRETKEY=Strong#Pass#1234
export S3_ENDPOINT=http://minio:9000 # host = the docker container name
export S3_REGION=sbg
export RSPY_TEMP_BUCKET=rs-dev-cluster-temp
export PREFECT_BUCKET_NAME=${RSPY_TEMP_BUCKET}
export BUCKET_CONFIG_FILE_PATH=/home/user/.config/expiration_bucket.csv

# http redirection port
export HTTP_REDIRECTION_PORT=10000

# RSPY working dir as a docker named volume
export RSPY_WORKING_DIR=/rspy/working/dir

# Config files
export EODAG_ADGS_CONFIG=/app/conf/adgs_ws_config.yaml
export EODAG_CADIP_CONFIG=/app/conf/cadip_ws_config.yaml
export EODAG_PRIP_CONFIG=/app/conf/prip_ws_config.yaml
export EDRS_STATION_CONFIG=/app/conf/rs_server_edrs_config.yaml
# opentelementry
export LOKI_ENDPOINT=http://loki:3100/loki/api/v1/push
export TEMPO_ENDPOINT=http://tempo:4317
export OTEL_PYTHON_REQUESTS_TRACE_HEADERS=1
export OTEL_PYTHON_REQUESTS_TRACE_BODY=1

# prefect url from inside the cluster = <container-name>:<default-dask-port>
export PREFECT_URL=http://prefect-server:4200
export PREFECT_API_URL=${PREFECT_URL}/api
# from outside the cluster = localhost:<mapped-port>
export RSPY_PREFECT_URL=http://localhost:4200
# work pool name
export PREFECT_WORK_POOL_STAGING="pefect-pool-staging"
export PREFECT_WORK_POOL_EOPF="pefect-pool-eopf"
export PREFECT_WORK_POOL_GENERAL="pefect-pool-general"

# dask urls from inside the cluster = <container-name>:<default-dask-port>
export DASK_GATEWAY_STAGING_ADDRESS=http://dask-staging:8000
export DASK_GATEWAY_EOPF_MOCKUP_ADDRESS=http://dask-eopf-mockup:8000
export DASK_GATEWAY_L0_ADDRESS=http://dask-l0:8000
export DASK_GATEWAY_S1ARD_ADDRESS=http://dask-s1ard:8000
# from outside the cluster = localhost:<mapped-port>
export DASK_GATEWAY_STAGING_PUBLIC=http://localhost:8701
export DASK_GATEWAY_EOPF_MOCKUP_PUBLIC=http://localhost:8703
export DASK_GATEWAY_L0_PUBLIC=http://localhost:8702
export DASK_GATEWAY_S1ARD_PUBLIC=http://localhost:8704
# dask cluster names
export RSPY_DASK_STAGING_CLUSTER_NAME="dask-staging"
# dask authentication in local mode
export LOCAL_DASK_USERNAME="local-dask-username"
export LOCAL_DASK_PASSWORD="local-dask-password"

# Memory (RAM) for each Dask worker. See: dask_gateway_server/backends/base.py::ClusterConfig.worker_memory
export DASK_MEMORY_EOPF="8G"
# Number of cpu-cores per Dask worker. See: dask_gateway_server/backends/base.py::ClusterConfig.worker_cores
export DASK_CORES_EOPF=2

# Variables to define access and refresh token lifetime
export RSPY_EXPIRES_IN=1200
export RSPY_REFRESH_EXPIRES_IN=3600

# EDRS FTPS credentials

export EDRS_FTP_USER='user'
export EDRS_FTP_PASS='password'
export EDRS_CLIENT_CRT_PATH='/certs/client.crt'
export EDRS_CLIENT_KEY_PATH='/certs/client.key'
export EDRS_CA_CRT_PATH='/certs/ca.crt'
