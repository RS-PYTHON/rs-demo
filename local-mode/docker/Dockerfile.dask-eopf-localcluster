# We will add eopf to the rs-dpr-service image
FROM ghcr.io/rs-python/rs-dpr-service:latest

# requirements.txt file
ARG REQ_FILE=xxx

# Default user from parent image
ARG USER=user

# Do everything from root
USER root

# System installations
RUN apt update && apt install -y git

# Install processor and eopf
COPY "$REQ_FILE" /opt/
# NOTE, with older docker versions, use:
# RUN --mount=type=secret,id=GITLAB_EOPF_TOKEN \
# GITLAB_EOPF_TOKEN=$(cat /run/secrets/GITLAB_EOPF_TOKEN) pip install ...
RUN --mount=type=secret,id=GITLAB_EOPF_TOKEN,env=GITLAB_EOPF_TOKEN \
    pip install -U pip && \
    pip install -U -r /opt/$(basename "$REQ_FILE")

# Other installations
RUN \
    apt update && \
    apt install -y \
        python3-pydot graphviz && \
    pip install \
        bokeh">=3.1.0" \
        jupyter-server-proxy

# Auto configure opentelemetry
RUN opentelemetry-bootstrap -a install

# Clean everything
RUN apt autoremove -y git
RUN rm -rf /tmp/whl /root/.cache/pip /var/cache/apt/archives /var/lib/apt/lists/* /opt/requirements.dask-l0-local.txt

# Restore user
USER $USER

# Set labels based on the Open Containers Initiative (OCI):
LABEL org.opencontainers.image.source="https://github.com/RS-PYTHON/rs-demo"
LABEL dockerfile.url="https://github.com/RS-PYTHON/rs-demo/blob/develop/local-mode/docker/Dockerfile.dask-eopf-localcluster"

# This Dockerfile is used to build:
# ghcr.io/rs-python/dask-gateway-server/l0/localcluster
# ghcr.io/rs-python/dask-gateway-server/s1ard/localcluster
