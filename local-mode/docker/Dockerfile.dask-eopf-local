# We will add eopf to the dask-gateway-server image for local mode
ARG DASK_TAG=xxx
FROM ghcr.io/rs-python/dask-gateway-server/base/local:${DASK_TAG}
ARG DASK_TAG=xxx

# Default user from parent image
ARG USER=dask:dask

ARG EOPF_PIP_VERSION

# Set labels based on the Open Containers Initiative (OCI):
# https://github.com/opencontainers/image-spec/blob/main/annotations.md#pre-defined-annotation-keys
#
LABEL org.opencontainers.image.source="https://github.com/RS-PYTHON/rs-demo"
LABEL org.opencontainers.image.url="https://github.com/RS-PYTHON/rs-demo/blob/develop/local-mode/docker/Dockerfile.dask-eopf-local"

# Install complete dask subsets + prefect
RUN pip install -U pip && \
pip install -U \
    dask[complete]=="${DASK_TAG}" \
    prefect[dask]=="3.1.4"

# Install EOPF, see e.g. https://gitlab.eopf.copernicus.eu/cpm/eopf-cpm/-/packages/1677
RUN --mount=type=secret,id=EOPF_TOKEN,env=EOPF_TOKEN \
    pip install eopf${EOPF_PIP_VERSION} \
    --index-url https://__token__:${EOPF_TOKEN}@gitlab.eopf.copernicus.eu/api/v4/projects/14/packages/pypi/simple

# Clean everything
USER root
RUN rm -rf /tmp/whl /root/.cache/pip /var/cache/apt/archives /var/lib/apt/lists/*
USER $USER
